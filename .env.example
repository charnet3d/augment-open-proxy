AOP_PORT=7888
AOP_HOST=localhost
# Per-request logging verbosity. One of:
#   none  → silent (no per-request log lines)
#   info  → one line per request with method, path, status, durationMs,
#           model, requestId, usage tokens (default)
#   body  → "info" plus full request body and assembled response body; use
#           this to audit exactly what was sent and received
AOP_LOGGING=info
# Output shape for log records. One of:
#   text  → human-readable single line — best for local development (default)
#   json  → single-line JSON per record — best for jq / Loki / Vector
AOP_LOG_FORMAT=text
# Comma- or whitespace-separated model IDs (or CLI short names like opus4.6).
# A base ID disables all its advertised effort variants; a suffixed ID such as
# claude-opus-4-7-low disables only that effort. Disabled variants are hidden
# from /v1/models and skipped when rewriting `reasoning_effort`.
AOP_DISABLE_EFFORT_MODELS=claude-opus-4-5,claude-opus-4-6,claude-opus-4-6-500k,claude-opus-4-7-low,claude-opus-4-7-max,claude-opus-4-7-500k,claude-opus-4-8-low,claude-opus-4-8-max,claude-opus-5-low,claude-opus-5-max,claude-sonnet-4-6,claude-sonnet-4-6-500k,gpt-5-6-luna,gpt-5-6-sol,gpt-5-6-terra
# Upstream HTTP timeouts (milliseconds). Node's global fetch defaults to a
# 5-minute headers timeout, which trips long thinking calls with
# UND_ERR_HEADERS_TIMEOUT. The proxy installs a global undici dispatcher with
# the values below. Set to 0 to disable a timeout entirely.
#   AOP_HEADERS_TIMEOUT_MS — wait for first response byte (default 1800000 = 30 min)
#   AOP_BODY_TIMEOUT_MS    — wait between body chunks    (default 1800000 = 30 min)
#   AOP_CONNECT_TIMEOUT_MS — TCP connect                 (default 30000   = 30 s)
# AOP_HEADERS_TIMEOUT_MS=1800000
# AOP_BODY_TIMEOUT_MS=1800000
# AOP_CONNECT_TIMEOUT_MS=30000
# AUGMENT_API_TOKEN=YOUR-ACCESS-TOKEN
# AUGMENT_API_URL=https://YOUR-TENANT.api.augmentcode.com
