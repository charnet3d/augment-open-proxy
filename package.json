{
  "name": "augment-open-proxy",
  "version": "1.0.3",
  "description": "HTTP proxy that lets OpenAI- and Anthropic-compatible clients (Claude Code, Cursor, Continue) talk to the Augment backend via the Augment SDK.",
  "main": "dist/index.js",
  "bin": {
    "augment-open-proxy": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "build:sea": "node scripts/build-sea.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "augment",
    "proxy",
    "openai",
    "anthropic",
    "claude",
    "claude-code",
    "cursor",
    "continue",
    "llm"
  ],
  "author": "Charaf Errachidi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charnet3d/augment-open-proxy.git"
  },
  "homepage": "https://github.com/charnet3d/augment-open-proxy#readme",
  "bugs": {
    "url": "https://github.com/charnet3d/augment-open-proxy/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "dependencies": {
    "@augmentcode/auggie-sdk": "^0.1.15",
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.15",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.21.0",
    "typescript": "5.7",
    "vitest": "^4.1.5"
  }
}
